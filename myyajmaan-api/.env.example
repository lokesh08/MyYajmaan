# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
APP_HOST=
APP_PORT=
FRONTEND_ORIGINS=
SUPABASE_PUBLIC_BUCKET=
COOKIE_SECURE=
COOKIE_SAMESITE=
BANK_DETAILS_ENCRYPTION_KEY=
AADHAR_ENCRYPTION_KEY=
AADHAR_MOCK_MODE=

# ---------------------------------------------------------------
# Razorpay (customer payments). Test keys: Razorpay Dashboard ->
# Account & Settings -> API Keys (Test Mode). Key ID is public; the
# secret must never go in front-end code. On deployment set these as
# real environment variables instead of this file.
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MERCHANT_NAME=MyYajmaan
# LOCAL TESTING ONLY: true = fake order/payment, no Razorpay keys needed.
RAZORPAY_MOCK_MODE=false

# ---------------------------------------------------------------
# Signup OTP (one-time email + phone verification)
# ---------------------------------------------------------------
# LOCAL TESTING ONLY: true = no email/SMS is sent; the code is printed
# in this API's console and shown on the verify screen. It is ignored
# automatically when COOKIE_SECURE=true. Set false to use real delivery.
OTP_DEV_MODE=false
OTP_TTL_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
# Optional dedicated secret for hashing stored OTPs (defaults to the
# service-role key). Set a random value in production.
OTP_HASH_SECRET=

# Email OTP via any SMTP server (Gmail: smtp.gmail.com / 587 with an
# App Password; or Brevo, Amazon SES SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MyYajmaan
SMTP_USE_TLS=true

# Phone OTP via MSG91 (India). Needs an approved DLT OTP template.
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
SMS_DEFAULT_COUNTRY_CODE=91

# ---- SEO ----
# Public web address of the front-end (e.g. https://www.example.com), used for
# /sitemap-dynamic.xml. REQUIRED in production.
PUBLIC_SITE_URL=
SITEMAP_INCLUDE_PANDITS=true
