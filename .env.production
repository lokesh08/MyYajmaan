# Production build only (Vite loads this on `vite build`). Public values --
# never put secrets here. Settings in the Vercel dashboard override these.

# Vercel's /api rewrite can't proxy WebSockets, so the notifications socket
# connects to the API host directly (see src/services/notificationsApi.js).
VITE_WS_BASE_URL=wss://myyajmaan-api.onrender.com
