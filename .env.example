# Front-end (Vite) settings. Copy to .env. VITE_* values are public -
# they ship to the browser, so never put secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE=false

# Public web address of the site, no trailing slash (e.g. https://www.example.com).
# Used for canonical URLs, Open Graph tags and sitemap.xml. REQUIRED for a
# production build.
VITE_SITE_URL=

# Optional: minutes of inactivity before sign-out (default 30).
# VITE_IDLE_LOGOUT_MINUTES=30
